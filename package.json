{
  "name": "mastara-agent-news-ranking-app",
  "version": "1.0.0",
  "description": "カテゴリー別ニュースランキング上位3記事を要約するMastra Agent",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "agent": "node --env-file=.env scripts/ask.ts",
    "lint": "eslint src scripts tests --ext .ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts",
    "check:news": "node --env-file=.env scripts/check-news.ts",
    "check:agent": "node --env-file=.env scripts/check-agent.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@mastra/core": "1.71.0",
    "cheerio": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "mastra": "1.31.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@1.22.22"
}
